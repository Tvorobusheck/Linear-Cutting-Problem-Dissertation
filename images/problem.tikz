\begin{tikzpicture}[
    x=1cm, y=1cm,
    font=\scriptsize,
    flow/.style={-Latex, semithick},
    task/.style={
        draw,
        rounded corners,
        align=center,
        minimum width=2.6cm,
        minimum height=0.9cm,
        fill=blue!8
    },
    gateway/.style={
        draw,
        diamond,
        aspect=1.8,
        align=center,
        inner sep=1pt,
        fill=orange!12
    },
    event/.style={
        draw,
        circle,
        minimum size=0.55cm,
        inner sep=0pt
    },
    endevent/.style={
        draw,
        circle,
        double,
        minimum size=0.55cm,
        inner sep=0pt
    },
    lane title/.style={font=\scriptsize\bfseries},
    lbl/.style={font=\tiny, fill=white, inner sep=1pt}
]

% --- Пул и дорожки ---
\draw[rounded corners] (0,0) rectangle (20,10.6);
\draw (2.4,0) -- (2.4,10.6);

\draw (0,7.6) -- (20,7.6);
\draw (0,5.7) -- (20,5.7);
\draw (0,3.8) -- (20,3.8);
\draw (0,1.9) -- (20,1.9);

\node[lane title] at (1.2,9.1) {Зказчик};
\node[lane title] at (1.2,6.65) {БДМ};
\node[lane title] at (1.2,4.75) {Склад};
\node[lane title] at (1.2,2.85) {ПРС};
\node[lane title] at (1.2,0.95) {БРС};

% --- BPMN элементы ---
\node[event] (start) at (4.8,9.8) {};
\node[above=1pt] at (start.north) {Заказ};

\node[task] (plan) at (4.8,8.55) {Сформировать\\производственный план};

\node[task] (bdm) at (7.1,6.65) {Изготовить\\тамбуры};

\node[task] (wh1) at (9.6,4.75) {Разместить\\на складе};

\node[task] (prs) at (12.3,2.85) {Выполнить\\продольную резку};

\node[gateway] (gw) at (15.7,2.85) {Нужна\\БРС?};

\node[task] (wh2) at (17.2,4.75) {Передать рулоны\\для БРС на склад};

\node[task] (brs) at (17.2,0.95) {Выполнить\\бобинорезку};

\node[endevent] (end) at (18.5,9.8) {};
\node[above=1pt] at (end.north) {Заказ выполнен};

% --- Потоки ---
\draw[flow] (start.south) -- (plan.north);

\draw[flow] (plan) |- (bdm);

\draw[flow] (bdm) |- node[pos=0.25, left, lbl] {тамбуры} (wh1);

\draw[flow] (wh1) |- node[pos=0.25, left, lbl] {тамбуры} (prs);

\draw[flow] (prs.east) -- (gw.west);

\draw[flow] (gw.north) -- node[pos=0.22, right, lbl] {Да} (wh2);

\draw[flow] (wh2.south) -- node[midway, right, lbl] {рулоны\\для БРС} (brs.north);

\draw[flow] (gw.north) -- ++(-0.4,0) |- node[pos=0.20, left, lbl] {Нет} node[pos=0.72, above, lbl] {рулоны} (end.west);

\draw[flow] (brs.east) -- ++(1.2,0) |- node[pos=0.4, left, lbl] {рулоны} (end.east);

\end{tikzpicture}